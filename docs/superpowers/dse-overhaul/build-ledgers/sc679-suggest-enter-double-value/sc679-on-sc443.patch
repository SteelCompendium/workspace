From: Scott Tomaszewski <scottTomaszewski@gmail.com>
Date: Fri, 20 Nov 2026 16:01:34 -0500
Subject: [PATCH] test(SC-679): flip the AUTH-G13/G14/K09 markers and the jsdom
 marker to plain tests; AUTH-G15..G20, AUTH-K10..K16 (scratch, on SC-443)

---
 e2e/specs/authoring/gate-on.e2e.ts            | 114 ++++++++++++++--
 e2e/specs/authoring/schema-suggest.e2e.ts     | 128 ++++++++++++++++--
 test/dom/authoring/authoringKnownBugs.test.ts |   2 +-
 3 files changed, 224 insertions(+), 20 deletions(-)

diff --git a/e2e/specs/authoring/gate-on.e2e.ts b/e2e/specs/authoring/gate-on.e2e.ts
index 910c835c..09a7f373 100644
--- a/e2e/specs/authoring/gate-on.e2e.ts
+++ b/e2e/specs/authoring/gate-on.e2e.ts
@@ -6,9 +6,9 @@
 // which stays out of the palette and `/ds` even with the gate on (SC-190).
 import { expect } from '@wdio/globals';
 import { browser } from '@wdio/globals';
-import { dse, knownBug } from '../../driver/dse';
+import { dse } from '../../driver/dse';
 import {
-	clickRow, closeList, drawn, editorState, insertCommandIds, openEditor, paletteRows, pressList, savedText, scaffoldOf, setCursor, spliced, toReading, typeKeys, waitList, waitNoList,
+	clickRow, closeList, drawn, editorState, insertCommandIds, listRows, openEditor, paletteRows, pressList, savedText, scaffoldOf, selectedListRow, spliced, toReading, typeKeys, waitList, waitNoList,
 } from '../../driver/authoring';
 import { advertised, commandTrip, CURSOR, NOTE_BEFORE } from '../../driver/authoringTrips';
 
@@ -55,8 +55,7 @@ describe('authoring with the experimental gate on', () => {
 		await clickRow('authoring.schema.value', 2);
 		await closeList();
 		expect(await savedText(rel)).toBe('```ds-roll\nmode: opposed\n```\n');
-		// (an accept with nothing typed leaves the cursor in front of the inserted value, SC-679, AUTH-G13: put it at the line's end to go on)
-		await setCursor({ line: 1, ch: 13 });
+		// (the accept left the cursor after the value and no list on screen: SC-679, AUTH-G13..G15)
 		await typeKeys('\ndifficulty: m', 'authoring.schema.trigger');
 		expect((await waitList(1)).map((r) => [r.id, r.text])).toEqual([['authoring.schema.value', 'medium']]);
 		await pressList('Enter');
@@ -87,25 +86,118 @@ describe('authoring with the experimental gate on', () => {
 		await closeList();
 	});
 
-	// SC-679: an accept with nothing typed (start == end) leaves the cursor in front of the inserted value and the old list on screen.
-	const pickOpposed = async (rel: string): Promise<void> => {
-		await openEditor(rel, '```ds-roll\n\n```\n', 'live-preview', { line: 1, ch: 0 });
+	// SC-679: an accept with nothing typed (start == end) used to leave the cursor in front of the inserted value and the old list on screen.
+	const pickOpposed = async (rel: string, text = '```ds-roll\n\n```\n'): Promise<void> => {
+		await openEditor(rel, text, 'live-preview', { line: 1, ch: 0 });
 		await typeKeys('mode: ', 'authoring.schema.trigger');
 		await waitList(4);
 		await clickRow('authoring.schema.value', 2);
 		await dse.waitFor(`app.workspace.getMostRecentLeaf().view.editor.getValue() === ${JSON.stringify('```ds-roll\nmode: opposed\n```\n')}`, 'the value to be written');
 	};
-	knownBug('SC-679', '[AUTH-G13] picking `opposed` with nothing typed after `mode: ` leaves the cursor after the value', async () => {
+	it('[AUTH-G13] picking `opposed` with nothing typed after `mode: ` leaves the cursor after the value and no list on screen', async () => {
 		await pickOpposed('Authoring/gate-cursor.md');
 		expect((await editorState()).cursor).toEqual({ line: 1, ch: 13 });
-	}, { failsWith: /Expected|Received/ });
+		await waitNoList();
+	});
 
-	knownBug('SC-679', '[AUTH-G14] after picking `opposed` with nothing typed, Escape then Enter (a new line) leaves `mode: opposed` whole', async () => {
+	it('[AUTH-G14] after picking `opposed` with nothing typed, Escape then Enter (a new line) leaves `mode: opposed` whole', async () => {
 		await pickOpposed('Authoring/gate-enter.md');
 		await browser.keys('Escape');
 		await waitNoList();
 		await browser.keys('Enter');
 		await dse.settle();
 		expect((await editorState()).value.split('\n')[1]).toBe('mode: opposed');
-	}, { failsWith: /mode: opposed/ });
+	});
+
+	it('[AUTH-G15] a click on a row with nothing typed, then Enter with NO Escape: a new line, `mode: opposed` whole, the cursor on the new line', async () => {
+		const rel = 'Authoring/gate-click-enter.md';
+		await pickOpposed(rel);
+		await waitNoList(); // no stale rows, no reopened one-row list
+		await browser.keys('Enter');
+		await dse.settle();
+		const state = await editorState();
+		expect(state.value).toBe('```ds-roll\nmode: opposed\n\n```\n');
+		expect(state.cursor).toEqual({ line: 2, ch: 0 });
+		expect(await savedText(rel)).toBe('```ds-roll\nmode: opposed\n\n```\n');
+		await waitNoList();
+	});
+
+	it('[AUTH-G16] the same by keyboard: Enter on a row (the third, after two ArrowDown) with nothing typed, then Enter again: a new line, `mode: opposed` whole', async () => {
+		const rel = 'Authoring/gate-key-enter.md';
+		await openEditor(rel, '```ds-roll\n\n```\n', 'live-preview', { line: 1, ch: 0 });
+		await typeKeys('mode: ', 'authoring.schema.trigger');
+		await waitList(4);
+		await browser.keys(['ArrowDown', 'ArrowDown']); // raw keys: the manifest has no `press:ArrowDown` pair for a value row
+		expect(await selectedListRow()).toBe(2);
+		await pressList('Enter');
+		await waitNoList();
+		expect((await editorState()).cursor).toEqual({ line: 1, ch: 13 });
+		await browser.keys('Enter');
+		await dse.settle();
+		expect((await editorState()).value).toBe('```ds-roll\nmode: opposed\n\n```\n');
+		expect((await editorState()).cursor).toEqual({ line: 2, ch: 0 });
+	});
+
+	// A canary for Obsidian's own behaviour, not DSE's: on the pinned 1.14.4 Tab does not accept a row. It guards the docs wording "Enter or a click"
+	// and goes red exactly when an Obsidian that binds Tab means the docs must change.
+	it('[AUTH-G17] Tab does not accept a row (the list stays, the note is unchanged); Enter then writes one value, and one more Enter is a new line', async () => {
+		const rel = 'Authoring/gate-tab.md';
+		await openEditor(rel, '```ds-roll\n\n```\n', 'live-preview', { line: 1, ch: 0 });
+		await typeKeys('mode: ', 'authoring.schema.trigger');
+		await waitList(4);
+		await browser.keys('Tab');
+		// a bounded quiet window (about 400 ms): every read in it must show that nothing happened
+		for (let i = 0; i < 5; i++) {
+			expect((await editorState()).value).toBe('```ds-roll\nmode: \n```\n');
+			expect(await listRows()).toHaveLength(4);
+			await browser.pause(80);
+		}
+		await pressList('Enter');
+		await waitNoList();
+		expect((await editorState()).value).toBe('```ds-roll\nmode: power-roll\n```\n');
+		await browser.keys('Enter');
+		await dse.settle();
+		expect((await editorState()).value).toBe('```ds-roll\nmode: power-roll\n\n```\n');
+	});
+
+	// SC-679, no wait between the accept and the next Enter: Obsidian keeps the old rows up for about 100 ms after an accept unless the suggester
+	// closes the list itself, and an Enter in that window used to accept the stale row again (`mode: opposedopposed`).
+	it('[AUTH-G19] a click on a row with nothing typed, then Enter at once (no wait): `mode: opposed` whole plus a new line', async () => {
+		const rel = 'Authoring/gate-burst-click.md';
+		await openEditor(rel, '```ds-roll\n\n```\n', 'live-preview', { line: 1, ch: 0 });
+		await typeKeys('mode: ', 'authoring.schema.trigger');
+		await waitList(4);
+		await clickRow('authoring.schema.value', 2);
+		await browser.keys('Enter');
+		await dse.settle();
+		const state = await editorState();
+		expect(state.value).toBe('```ds-roll\nmode: opposed\n\n```\n');
+		expect(state.cursor).toEqual({ line: 2, ch: 0 });
+	});
+
+	it('[AUTH-G20] Enter, Enter in one burst on the open value list: the first row once (`mode: power-roll`) plus a new line', async () => {
+		const rel = 'Authoring/gate-burst-keys.md';
+		await openEditor(rel, '```ds-roll\n\n```\n', 'live-preview', { line: 1, ch: 0 });
+		await typeKeys('mode: ', 'authoring.schema.trigger');
+		await waitList(4);
+		await browser.keys(['Enter', 'Enter']);
+		await dse.settle();
+		const state = await editorState();
+		expect(state.value).toBe('```ds-roll\nmode: power-roll\n\n```\n');
+		expect(state.cursor).toEqual({ line: 2, ch: 0 });
+	});
+
+	it('[AUTH-G18] a typed prefix (`mode: op`) accepted with Enter: the value replaces what was typed, the cursor is after it, no list is on screen and the next Enter is a new line', async () => {
+		const rel = 'Authoring/gate-typed.md';
+		await openEditor(rel, '```ds-roll\n\n```\n', 'live-preview', { line: 1, ch: 0 });
+		await typeKeys('mode: op', 'authoring.schema.trigger');
+		expect((await waitList(1)).map((r) => r.text)).toEqual(['opposed']);
+		await pressList('Enter');
+		await waitNoList();
+		expect((await editorState()).cursor).toEqual({ line: 1, ch: 13 });
+		await browser.keys('Enter');
+		await dse.settle();
+		expect((await editorState()).value).toBe('```ds-roll\nmode: opposed\n\n```\n');
+	});
+
 });
diff --git a/e2e/specs/authoring/schema-suggest.e2e.ts b/e2e/specs/authoring/schema-suggest.e2e.ts
index 1c841be8..584a6705 100644
--- a/e2e/specs/authoring/schema-suggest.e2e.ts
+++ b/e2e/specs/authoring/schema-suggest.e2e.ts
@@ -4,8 +4,8 @@
 // block uses the second's. Silent outside the block, on a fence line, on an indented line, and for the deferred elements while the gate is OFF.
 // (The enum value list exists only with the gate ON: AUTH-G10.)
 import { browser, expect } from '@wdio/globals';
-import { dse, knownBug } from '../../driver/dse';
-import { clickRow, closeList, editorState, openEditor, pressList, savedText, selectedListRow, setCursor, spliced, typeKeys, waitList, waitNoList } from '../../driver/authoring';
+import { dse } from '../../driver/dse';
+import { clickRow, closeList, editorState, listRows, openEditor, pressList, savedText, selectedListRow, setCursor, spliced, typeKeys, waitList, waitNoList } from '../../driver/authoring';
 
 const TRIGGER = 'authoring.schema.trigger';
 const KEY = 'authoring.schema.key';
@@ -108,17 +108,129 @@ describe('in-fence key autocomplete', () => {
 		expect((await waitList(1)).map((r) => r.text)).toEqual(['current_stamina']);
 	});
 
-	// SC-679, shipped build: the key list opened on an empty line with nothing typed (type a letter, delete it) and a pick leaves the cursor
-	// in front of the key and the old list on screen; the next Enter writes a second key (`collapsiblecollapsible`).
-	knownBug('SC-679', '[AUTH-K09] picking a key with nothing typed leaves the cursor after the key', async () => {
+	// SC-679, shipped build: the key list opened on an empty line with nothing typed (type a letter, delete it) and a pick used to leave the cursor
+	// in front of the key and the old list on screen; the next Enter wrote a second key (`collapsiblecollapsible`).
+	const emptyLinePick = async (rel: string, text: string, at: { line: number; ch: number }, nth: number): Promise<void> => {
+		await openEditor(rel, text, 'live-preview', at);
+		await typeKeys('c', TRIGGER);
+		await waitList();
+		await browser.keys('Backspace');
+		await waitList(9);
+		await clickRow(KEY, nth);
+	};
+	it('[AUTH-K09] picking a key with nothing typed leaves the cursor after the key and no list on screen', async () => {
 		const rel = 'Authoring/key-empty-query.md';
+		await emptyLinePick(rel, STAM, AT, 0);
+		await dse.waitFor(`app.workspace.getMostRecentLeaf().view.editor.getValue() === ${JSON.stringify(spliced(STAM, AT, undefined, 'collapsible'))}`, 'the key to be written');
+		expect((await editorState()).cursor).toEqual({ line: 1, ch: 11 });
+		await waitNoList();
+	});
+
+	it('[AUTH-K10] the key is picked with nothing typed, then Enter with no Escape: a new line, the key line whole (no `collapsiblecollapsible`)', async () => {
+		const rel = 'Authoring/key-empty-enter.md';
 		await openEditor(rel, STAM, 'live-preview', AT);
 		await typeKeys('c', TRIGGER);
 		await waitList();
 		await browser.keys('Backspace');
 		await waitList(9);
+		await pressList('Enter'); // the first row, `collapsible`
+		await waitNoList();
+		await browser.keys('Enter');
+		await dse.settle();
+		expect((await editorState()).value).toBe('```ds-stam\ncollapsible\n\n```\nafter\n');
+		expect((await editorState()).cursor).toEqual({ line: 2, ch: 0 });
+		expect(await savedText(rel)).toBe('```ds-stam\ncollapsible\n\n```\nafter\n');
+	});
+
+	it('[AUTH-K11] a typed prefix (`cur`) accepted with Enter: the cursor is after `current_stamina`, no list is on screen, the next Enter is a new line', async () => {
+		const rel = 'Authoring/key-typed-enter.md';
+		await openEditor(rel, STAM, 'live-preview', AT);
+		await typeKeys('cur', TRIGGER);
+		await waitList(1);
 		await pressList('Enter');
-		await dse.waitFor(`app.workspace.getMostRecentLeaf().view.editor.getValue() === ${JSON.stringify(spliced(STAM, AT, undefined, 'collapsible'))}`, 'the key to be written');
-		expect((await editorState()).cursor).toEqual({ line: 1, ch: 11 });
-	}, { failsWith: /Expected|Received/ });
+		await waitNoList();
+		expect((await editorState()).cursor).toEqual({ line: 1, ch: 15 });
+		await browser.keys('Enter');
+		await dse.settle();
+		expect((await editorState()).value).toBe('```ds-stam\ncurrent_stamina\n\n```\nafter\n');
+	});
+
+	it('[AUTH-K12] typing on after a pick keeps working: `style` picked with nothing typed, then `: ` opens its value list; `rec` picked (recoveries) then `_` lists recoveries_max', async () => {
+		await emptyLinePick('Authoring/key-then-colon.md', STAM, AT, 8); // the ninth row: style
+		await dse.waitFor(`app.workspace.getMostRecentLeaf().view.editor.getValue() === ${JSON.stringify(spliced(STAM, AT, undefined, 'style'))}`, 'the key to be written');
+		await waitNoList();
+		await typeKeys(': ', TRIGGER);
+		expect((await waitList(2)).map((r) => r.text)).toEqual(['default', 'sheet']);
+		await browser.keys('Escape');
+		await waitNoList();
+		await openEditor('Authoring/key-prefix-pair.md', STAM, 'live-preview', AT);
+		await typeKeys('rec', TRIGGER);
+		expect((await waitList(2)).map((r) => r.text)).toEqual(['recoveries', 'recoveries_max']);
+		await pressList('Enter');
+		await waitNoList();
+		expect((await editorState()).value.split('\n')[1]).toBe('recoveries');
+		await typeKeys('_', TRIGGER);
+		expect((await waitList(1)).map((r) => r.text)).toEqual(['recoveries_max']);
+		await browser.keys('Escape');
+		await waitNoList();
+	});
+
+	it('[AUTH-K13] one Ctrl+Z after a pick with nothing typed: the note is not left damaged (it takes the pick back, nothing else)', async () => {
+		const rel = 'Authoring/key-undo.md';
+		await emptyLinePick(rel, STAM, AT, 0);
+		await waitNoList();
+		await browser.keys(['Control', 'z']);
+		await dse.waitFor(`app.workspace.getMostRecentLeaf().view.editor.getValue() === ${JSON.stringify(STAM)}`, 'the undo to take the pick back');
+		await waitNoList();
+		const state = await editorState();
+		// Observed in Obsidian 1.14.4: the one undo takes the pick back (the typed `c` and its Backspace were two earlier steps that cancel out), so the
+		// block is as before the pick, with no list on screen.
+		expect(state.value).toBe(STAM);
+		expect(await listRows()).toHaveLength(0);
+	});
+
+	// SC-679, no wait between the accept and the next Enter (see AUTH-G19): the shipped key list and a typed prefix.
+	it('[AUTH-K15] a key picked with nothing typed by Enter, Enter in one burst: the key once (`collapsible`) plus a new line', async () => {
+		const rel = 'Authoring/key-burst-empty.md';
+		await openEditor(rel, STAM, 'live-preview', AT);
+		await typeKeys('c', TRIGGER);
+		await waitList();
+		await browser.keys('Backspace');
+		await waitList(9);
+		await browser.keys(['Enter', 'Enter']);
+		await dse.settle();
+		const state = await editorState();
+		expect(state.value).toBe('```ds-stam\ncollapsible\n\n```\nafter\n');
+		expect(state.cursor).toEqual({ line: 2, ch: 0 });
+	});
+
+	it('[AUTH-K16] `rec` accepted with Enter, Enter in one burst: `recoveries` once (not `recoveriesoveries`) plus a new line', async () => {
+		const rel = 'Authoring/key-burst-typed.md';
+		await openEditor(rel, STAM, 'live-preview', AT);
+		await typeKeys('rec', TRIGGER);
+		await waitList(2);
+		await browser.keys(['Enter', 'Enter']);
+		await dse.settle();
+		const state = await editorState();
+		expect(state.value).toBe('```ds-stam\nrecoveries\n\n```\nafter\n');
+		expect(state.cursor).toEqual({ line: 2, ch: 0 });
+	});
+
+	it('[AUTH-K14] integrity: the text above and below the block and a second ds-* block in the note are byte-identical after a pick with nothing typed', async () => {
+		const rel = 'Authoring/key-integrity.md';
+		const note = '# Above\n\nsome prose\n\n```ds-stam\n\n```\n\nbetween\n\n```ds-skills\nonly_show_selected: true\n```\n\nbelow\n';
+		const at = { line: 5, ch: 0 };
+		await openEditor(rel, note, 'source', at);
+		await typeKeys('c', TRIGGER);
+		await waitList();
+		await browser.keys('Backspace');
+		await waitList(9);
+		await clickRow(KEY, 0);
+		await waitNoList();
+		expect(await savedText(rel)).toBe(spliced(note, at, undefined, 'collapsible'));
+		await browser.keys('Enter');
+		await dse.settle();
+		expect(await savedText(rel)).toBe(spliced(note, at, undefined, 'collapsible\n'));
+	});
+
 });
diff --git a/test/dom/authoring/authoringKnownBugs.test.ts b/test/dom/authoring/authoringKnownBugs.test.ts
index 8bbf9c7e..6329a2ae 100644
--- a/test/dom/authoring/authoringKnownBugs.test.ts
+++ b/test/dom/authoring/authoringKnownBugs.test.ts
@@ -100,7 +100,7 @@ describe('SC-678: accepting a key with the cursor in the middle of a word', () =
 });
 
 describe('SC-679: accepting a suggestion with nothing typed', () => {
-	test.failing('leaves the cursor after the inserted value (an empty range maps the cursor to the front of it)', () => {
+	test('leaves the cursor after the inserted value (an empty range maps the cursor to the front of it)', () => {
 		const editor = new CmEditor('```ds-roll\nmode: \n```', { line: 1, ch: 6 });
 		const s = new DsSchemaSuggest(new App() as any, registry());
 		const info = s.onTrigger({ line: 1, ch: 6 }, editor as never, null)!;
