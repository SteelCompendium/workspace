@@ -0,0 +1,51 @@
+import { mapLine } from '@/framework/host/lineMap';
+
+const twin = (v: number) => ['```ds-counter', 'name: Twin', `current_value: ${v}`, '```'];
+const note = (vals: number[], extra: Record<number, string[]> = {}) =>
+	['# t', '', 'TOP', '', ...vals.flatMap((v, i) => [...(extra[i] ?? []), ...twin(v), '', `M${i}`, '']), 'BOTTOM'].join('\n');
+
+describe('mapLine (SC-552 prototype)', () => {
+	it('identity', () => {
+		const a = note([5, 5, 5]);
+		expect(mapLine(a, a, 12)).toBe(12);
+	});
+	it('a change in the upper twin keeps the middle and lower lines', () => {
+		const a = note([5, 5, 5]);
+		const b = note([6, 5, 5]);
+		const fences = a.split('\n').map((l, i) => (l === '```ds-counter' ? i : -1)).filter((i) => i >= 0);
+		expect(fences.map((f) => mapLine(a, b, f))).toEqual(fences);
+	});
+	it('changes above AND below the middle (upper and lower both written)', () => {
+		const a = note([5, 5, 5]);
+		const b = note([6, 5, 7]);
+		const f = a.split('\n').map((l, i) => (l === '```ds-counter' ? i : -1)).filter((i) => i >= 0);
+		expect(mapLine(a, b, f[1])).toBe(f[1]);
+		expect(mapLine(a, b, f[1] + 2)).toBe(f[1] + 2);
+		expect(mapLine(a, b, f[0] + 2)).toBeNull(); // the changed line itself
+	});
+	it('lines inserted above shift the block', () => {
+		const a = note([5, 5, 5]);
+		const b = note([5, 5, 5], { 0: ['NEW1', 'NEW2', ''] });
+		const fa = a.split('\n').map((l, i) => (l === '```ds-counter' ? i : -1)).filter((i) => i >= 0);
+		const fb = b.split('\n').map((l, i) => (l === '```ds-counter' ? i : -1)).filter((i) => i >= 0);
+		expect(fa.map((f) => mapLine(a, b, f))).toEqual(fb);
+	});
+	it('a line added inside the upper block and a line removed after the lower', () => {
+		const a = note([5, 5, 5]);
+		const bl = a.split('\n');
+		const f = bl.map((l, i) => (l === '```ds-counter' ? i : -1)).filter((i) => i >= 0);
+		bl.splice(f[0] + 2, 0, 'max_value: 20');
+		bl.splice(bl.length - 2, 1);
+		const b = bl.join('\n');
+		expect(mapLine(a, b, f[1])).toBe(f[1] + 1);
+		expect(mapLine(a, b, f[2])).toBe(f[2] + 1);
+	});
+	it('a deleted line maps to null', () => {
+		const a = ['x', 'y', 'z'].join('\n');
+		expect(mapLine(a, ['x', 'z'].join('\n'), 1)).toBeNull();
+		expect(mapLine(a, ['x', 'z'].join('\n'), 2)).toBe(1);
+	});
+	it('CRLF and LF compare by line (Obsidian numbering)', () => {
+		expect(mapLine('a\r\nb\r\nc', 'a\r\nB\r\nb\r\nc', 1)).toBe(2);
+	});
+});
