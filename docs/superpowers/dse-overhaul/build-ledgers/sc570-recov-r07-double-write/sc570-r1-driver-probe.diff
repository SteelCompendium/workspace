+const K7Q2_INSTALL = `(() => {
+	window.__sc570 = [];
+	if (window.__sc570hooked) return true;
+	window.__sc570hooked = true;
+	const v = app.vault;
+	const orig = v.process.bind(v);
+	const log = (o) => window.__sc570 && window.__sc570.push(Object.assign({ t: Math.round(performance.now()) }, o));
+	v.process = (file, fn, opts) => {
+		log({ ev: 'process-enter', path: file.path });
+		return orig(file, (c) => {
+			const out = fn(c);
+			log({ ev: 'process-cb', path: file.path, recoveries: (/^recoveries: (\\d+)$/m.exec(out) || [])[1], current_stamina: (/^current_stamina: (\\d+)$/m.exec(out) || [])[1], unchanged: out === c });
