+/** SC-601 (G-S97): the plan. GS97_REPS (default 3) and GS97_PLAN ('full' default; 'smoke' runs one of each kind) shape it. */
+function gs97Plan() {
+	const reps = Number(process.env.GS97_REPS ?? 3);
+	const smoke = process.env.GS97_PLAN === 'smoke';
+	const main = [];
+	const clicks = [
+		['input', 'click'],
+		['input', 'keys'],
+		['box', 'click'],
+		['box', 'keys'],
+		['bg', null],
+		['suggestion', null],
+	];
+	for (const open of ['cmd', 'hotkey', 'palette']) for (const [click, choose] of clicks) main.push({ where: 'hover', open, click, choose });
+	main.push({ where: 'hover', open: 'cmd', click: 'none', choose: 'keys' }); // no click at all: Enter on the open search
+	main.push({ where: 'hover', open: 'cmd', mode: 'lp', click: 'input', choose: 'click' }); // the host in Live Preview
+	main.push({ where: 'hover', open: 'cmd', lpConfig: true, click: 'input', choose: 'click' }); // the vault's Live Preview on (the preview's editor is LP)
+	main.push({ where: 'hover', open: 'block', click: 'input', choose: null }); // the snapshot command: the same modal
+	for (const [click, choose] of clicks) main.push({ where: 'pane', open: 'cmd', click, choose });
+	const controls = [
+		{ kind: 'switcher', click: 'input' },
+		{ kind: 'switcher', click: 'box' },
+		{ kind: 'palette', click: 'input' },
+		{ kind: 'stamina', click: 'title' },
+		{ kind: 'stamina', click: 'input' },
+	];
+	const template = [
+		{ where: 'hover', open: 'template', click: 'input', choose: 'click' },
+		{ where: 'hover', open: 'template', click: 'suggestion', choose: null },
+		{ where: 'hover', open: 'template', click: 'none', choose: 'keys' },
+		{ where: 'pane', open: 'template', click: 'input', choose: 'click' },
+		{ where: 'hover', open: 'template', mode: 'lp', click: 'input', choose: 'click' }, // the host in Live Preview: an editor of its own for the template to land in
+	];
+	if (process.env.GS97_PLAN === 'extra') return { reps, main: template, controls: [] };
+	if (process.env.GS97_PLAN === 'extra-lp') return { reps, main: template.slice(-1), controls: [] };
+	main.push(...template);
+	if (smoke) return { reps: 1, main: [main[2], main[4], main[7], main[13], main[18], main[19], main[20]], controls: [controls[2], controls[3], controls[4]] };
+	return { reps, main, controls };
