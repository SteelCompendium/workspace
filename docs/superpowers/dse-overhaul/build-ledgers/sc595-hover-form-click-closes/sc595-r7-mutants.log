import sys, shutil
M = sys.argv[2]
MM = M + '/src/framework/kit/managedModal.ts'
G = "if (evt.composedPath().includes(this.containerEl)) evt.stopPropagation();"
REM = "\t\tthis.lifecycle.register(() => {\n\t\t\twin.setTimeout(() => doc.removeEventListener('click', guard), 0);\n\t\t});\n"
RP = "if (!this.dseOpen || previewModals[previewModals.length - 1] !== this || activeWindow !== win) return;"
muts = {
 'M11-contains': [(MM, G, "{ const tg = evt.target as Node | null; if (tg && this.containerEl.contains(tg)) evt.stopPropagation(); }")],
 'M12-sync-removal': [(MM, REM, "\t\tthis.lifecycle.register(() => doc.removeEventListener('click', guard));\n")],
 'M13-arm-at-open': [(MM, "if (opening?.type === 'click') {", "if (false as boolean) {")],
 'M14-no-newest': [(MM, RP, "if (!this.dseOpen || activeWindow !== win) return;")],
 'M15-no-active-window': [(MM, RP, "if (!this.dseOpen || previewModals[previewModals.length - 1] !== this) return;")],
 'M16-only-10': [(MM, "= [10, 150];", "= [10];")],
 'R2-only-150': [(MM, "for (const ms of HOVER_HELPER_DELAYS_MS) {", "for (const ms of HOVER_HELPER_DELAYS_MS.filter((d) => d !== 10)) {")],
 'R1-arm-capture': [(MM, "win.addEventListener('click', onWindowBubble);", "win.addEventListener('click', onWindowBubble, true);"), (MM, "win.removeEventListener('click', onWindowBubble));", "win.removeEventListener('click', onWindowBubble, true));")],
 'R3-guard-never-removed': [(MM, REM, "")],
 'R4-removal-microtask': [(MM, "win.setTimeout(() => doc.removeEventListener('click', guard), 0);", "queueMicrotask(() => doc.removeEventListener('click', guard));")],
 'R5-arm-any-click': [(MM, "if (evt === opening) arm();", "void opening; arm();")],
 'R6-no-splice': [(MM, "if (i >= 0) previewModals.splice(i, 1);", "void i;")],
 'R7-no-dseOpen': [(MM, RP, "if (previewModals[previewModals.length - 1] !== this || activeWindow !== win) return;")],
 'M8-freeheal-no-anchor': [(M + '/src/views/StaminaEditModal.ts', "\t\t\t\t\t\t\tthis.anchor,\n", "")],
 'M9-conditions-panel-no-anchor': [(M + '/src/elements/conditions/panel.ts', "\t\t\tthis.cx.host.containerEl, // SC-595: keeps a hover preview alive while the modal is open\n", "")],
 'M10-montage-no-anchor': [(M + '/src/elements/montage/view.ts', "openManagedModal(modalOwner, factory, this.cx.host.containerEl);", "openManagedModal(modalOwner, factory);")],
}
name = sys.argv[1]
files = set()
for f, a, b in muts[name]:
    s = open(f).read()
    assert s.count(a) == 1, (name, a, s.count(a))
    open(f, 'w').write(s.replace(a, b))
    files.add(f)
print(' '.join(sorted(files)))
